@page
@model IndexModel
@{ ViewData["Title"] = T.Get(Context, "My leave tracker"); }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1>@T.Get(Context, "My leave tracker")</h1><p class="text-muted mb-0">@T.MonthName(Context, Model.CurrentMonth) @Model.CurrentYear</p></div>
    <form method="get" class="d-flex gap-2 align-items-end">
        <label>@T.Get(Context, "Month") <select class="form-select" name="month" onchange="this.form.submit()">@for (var month = 1; month <= 12; month++) { <option value="@month" selected="@(Model.CurrentMonth == month ? "selected" : null)">@T.MonthName(Context, month)</option> }</select></label>
        <label>@T.Get(Context, "Year") <input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" onchange="this.form.submit()" /></label>
        <noscript><button class="btn btn-outline-primary" type="submit">@T.Get(Context, "Open")</button></noscript>
    </form>
</div>

@if (Model.UserRecord?.Employee is null)
{
    <div class="alert alert-warning">@T.Get(Context, "Your Google account is not linked to an employee yet. Ask an administrator to add your email.")</div>
}
else
{
    <div class="card mb-4"><div class="card-body d-flex justify-content-between align-items-center">
        <div><strong>@T.Get(Context, "Monthly submission"):</strong> <span class="badge @(Model.SubmissionState == "Missing" ? "text-bg-warning" : "text-bg-success")">@T.Get(Context, Model.SubmissionState)</span></div>
        <div class="d-flex gap-2">
            <form method="post" asp-page-handler="NoAbsence"><input type="hidden" name="year" value="@Model.CurrentYear" /><input type="hidden" name="month" value="@Model.CurrentMonth" /><button class="btn btn-outline-secondary" type="submit">@T.Get(Context, "No absence this month")</button></form>
            <a class="btn btn-primary" asp-page="/Requests/Create" asp-route-year="@Model.CurrentYear" asp-route-month="@Model.CurrentMonth">@T.Get(Context, "Add absence")</a>
        </div>
    </div></div>

    <h2 class="h4">@T.Get(Context, "My absences")</h2>
    @if (Model.Requests.Count == 0) { <p class="text-muted">@T.Get(Context, "No absence records for this month.")</p> }
    else
    {
        <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>@T.Get(Context, "Type")</th><th>@T.Get(Context, "Start date")</th><th>@T.Get(Context, "End date")</th><th>@T.Get(Context, "Notes")</th><th></th></tr></thead><tbody>
        @foreach (var item in Model.Requests)
        { <tr><td>@item.LeaveType.Name</td><td>@item.StartDate.ToString("yyyy-MM-dd")</td><td>@item.EndDate.ToString("yyyy-MM-dd")</td><td>@item.Notes</td><td>@if (item.AttachmentOriginalName is not null) { <a asp-page="/Requests/Attachment" asp-route-id="@item.Id">@T.Get(Context, "Document")</a> } <a asp-page="/Requests/Edit" asp-route-id="@item.Id">@T.Get(Context, "Edit")</a></td></tr> }
        </tbody></table></div>
    }
}
