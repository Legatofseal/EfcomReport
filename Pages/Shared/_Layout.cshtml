<!DOCTYPE html>
<html lang="@T.Language(Context)" dir="@T.Direction(Context)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EfcomReport</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="portal-topbar">
    <nav class="navbar navbar-light bg-white border-bottom box-shadow">
        <div class="container-fluid portal-topbar-inner">
            <a class="navbar-brand" asp-page="/Index"><img class="site-logo" src="~/images/efcom-logo.png" alt="EfcomReport" /></a>
            <ul class="navbar-nav flex-row align-items-center gap-2">
                <li class="nav-item language-switcher">
                    <label class="nav-link text-muted mb-0" for="language-select">@T.Get(Context, "Language"):</label>
                    <select id="language-select" class="form-select form-select-sm" onchange="if (this.value) window.location.href = this.value" aria-label="@T.Get(Context, "Language")">
                        <option value="@T.LanguageUrl(Context, "en")" selected="@(T.Language(Context) == "en" ? "selected" : null)">English</option>
                        <option value="@T.LanguageUrl(Context, "he")" selected="@(T.Language(Context) == "he" ? "selected" : null)">עברית</option>
                        <option value="@T.LanguageUrl(Context, "ru")" selected="@(T.Language(Context) == "ru" ? "selected" : null)">Русский</option>
                    </select>
                </li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><span class="nav-link text-muted">@User.Identity.Name</span></li>
                    <li class="nav-item"><a class="nav-link" href="/account/logout">@T.Get(Context, "Sign out")</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" href="/account/login">@T.Get(Context, "Sign in")</a></li>
                }
            </ul>
        </div>
    </nav>
</header>

<div class="portal-shell">
    <aside class="portal-sidebar">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-heading">@T.Get(Context, "Tracker")</div>
            <a class="sidebar-link" asp-page="/Index">@T.Get(Context, "My tracker")</a>

            <div class="sidebar-heading mt-4">@T.Get(Context, "Invoices")</div>
            @if (User.IsInRole("Admin"))
            {
                <a class="sidebar-link" href="/Invoices/">@T.Get(Context, "Invoice entries")</a>
            }
            <a class="sidebar-link" asp-page="/Invoices/Create">@T.Get(Context, "New invoice entry")</a>

            @if (User.IsInRole("Admin"))
            {
                <div class="sidebar-heading mt-4">@T.Get(Context, "Administration")</div>
                <a class="sidebar-link" asp-page="/Admin/Index">@T.Get(Context, "Administration")</a>
                <a class="sidebar-link" asp-page="/Admin/Calendar">@T.Get(Context, "Work calendar")</a>
                <a class="sidebar-link" asp-page="/Admin/InvoiceRecipients">@T.Get(Context, "Invoice recipients")</a>
            }
        }
    </aside>

    <div class="portal-content">
        <main role="main" class="pb-3">
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success">@message</div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<footer class="border-top footer text-muted"><div class="container-fluid">&copy; 2026 - EfcomReport</div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
