@page
@model EfcomReport.Pages.CalendarModel
@{ ViewData["Title"] = T.Get(Context, "Work calendar"); }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>@T.Get(Context, "Work calendar")</h1><p class="text-muted mb-0">@T.Get(Context, "Read-only view of the administrator calendar.")</p></div><form method="get" class="d-flex gap-2"><select class="form-select" name="month">@for (var month = 1; month <= 12; month++) { <option value="@month" selected="@(Model.CurrentMonth == month ? "selected" : null)">@T.MonthName(Context, month)</option> }</select><input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" /><button class="btn btn-outline-primary">@T.Get(Context, "Open")</button></form></div>
<div class="calendar-legend mb-3"><span class="calendar-legend-item working">@T.Get(Context, "Working day")</span><span class="calendar-legend-item half-day">@T.Get(Context, "Half day")</span><span class="calendar-legend-item not-working">@T.Get(Context, "Day off")</span><span class="text-muted">@T.Get(Context, "Manual administrator changes are marked with *.")</span></div>
<div class="calendar-grid calendar-grid-readonly">@foreach (var day in Model.Days) { <div class="calendar-day @(day.IsWorking ? "working" : "not-working") @(day.IsHalfDay ? "half-day" : "")" title="@(day.IsOverride ? T.Get(Context, "Manual administrator override") : T.Get(Context, "Default calendar rule"))"><strong>@day.Date.Day</strong><span>@(day.IsHalfDay ? T.Get(Context, "Half day") : day.IsWorking ? T.Get(Context, "Working") : T.Get(Context, "Off"))@(day.IsOverride ? " *" : "")</span></div> }</div>
