@page
@model EfcomReport.Pages.Admin.RequestsModel
@{ ViewData["Title"] = "All absence requests"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>All absence requests</h1><form method="get" class="d-flex gap-2"><input class="form-control" type="number" name="month" min="1" max="12" value="@Model.CurrentMonth" /><input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" /><button class="btn btn-outline-primary">Open</button></form></div>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Employee</th><th>Type</th><th>Start</th><th>End</th><th>Submitted by</th><th></th></tr></thead><tbody>@foreach (var item in Model.Requests) { <tr><td>@item.Employee.Name</td><td>@item.LeaveType.Name</td><td>@item.StartDate.ToString("yyyy-MM-dd")</td><td>@item.EndDate.ToString("yyyy-MM-dd")</td><td>@item.CreatedByEmail</td><td><a asp-page="/Requests/Edit" asp-route-id="@item.Id">Edit</a></td></tr> }</tbody></table></div>
