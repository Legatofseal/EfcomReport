@page
@model EfcomReport.Pages.Admin.CalendarModel
@{ ViewData["Title"] = "Work calendar"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Work calendar</h1><form method="get" class="d-flex gap-2"><input class="form-control" type="number" name="month" min="1" max="12" value="@Model.CurrentMonth" /><input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" /><button class="btn btn-outline-primary">Open</button></form></div>
<p class="text-muted">Default: Sunday–Thursday working. Click a date to create or change an override.</p>
<div class="calendar-grid">@foreach (var day in Model.Days) { <form method="post" asp-page-handler="Toggle"><input type="hidden" name="date" value="@day.Date.ToString("yyyy-MM-dd")" /><input type="hidden" name="year" value="@Model.CurrentYear" /><input type="hidden" name="month" value="@Model.CurrentMonth" /><button class="calendar-day @(day.IsWorking ? "working" : "not-working")" title="@(day.IsOverride ? "Manual override" : "Default rule")"><strong>@day.Date.Day</strong><span>@(day.IsWorking ? "Working" : "Off")</span></button></form> }</div>
