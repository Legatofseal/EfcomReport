@page
@model EfcomReport.Pages.Admin.CalendarModel
@{ ViewData["Title"] = T.Get(Context, "Work calendar"); }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>@T.Get(Context, "Work calendar")</h1><form method="get" class="d-flex gap-2"><select class="form-select" name="month">@for (var month = 1; month <= 12; month++) { <option value="@month" selected="@(Model.CurrentMonth == month ? "selected" : null)">@T.MonthName(Context, month)</option> }</select><input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" /><button class="btn btn-outline-primary">@T.Get(Context, "Open")</button></form></div>
<p class="text-muted">@T.Get(Context, "Default: Sunday–Thursday working. Click a date to create or change an override.")</p>
<div class="calendar-grid">@foreach (var day in Model.Days) { <form method="post" asp-page-handler="Set" class="calendar-editor @(day.IsHalfDay ? "half-day" : day.IsWorking ? "working" : "not-working")"><input type="hidden" name="date" value="@day.Date.ToString("yyyy-MM-dd")" /><input type="hidden" name="year" value="@Model.CurrentYear" /><input type="hidden" name="month" value="@Model.CurrentMonth" /><strong>@day.Date.Day</strong><select class="form-select form-select-sm" name="status" title="@(day.IsOverride ? T.Get(Context, "Manual administrator override") : T.Get(Context, "Default calendar rule"))"><option value="default" selected="@(day.Status == "default" ? "selected" : null)">@T.Get(Context, "Default")</option><option value="working" selected="@(day.Status == "working" ? "selected" : null)">@T.Get(Context, "Working")</option><option value="half" selected="@(day.Status == "half" ? "selected" : null)">@T.Get(Context, "Half day")</option><option value="off" selected="@(day.Status == "off" ? "selected" : null)">@T.Get(Context, "Off")</option></select><button class="btn btn-sm btn-outline-primary" type="submit">@T.Get(Context, "Save")</button></form> }</div>
