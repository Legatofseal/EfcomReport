@page
@model EfcomReport.Pages.Admin.SettingsModel
@{ ViewData["Title"] = T.Get(Context, "Employees and settings"); }
<h1>@T.Get(Context, "Employees and settings")</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-4">
    <div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">@T.Get(Context, "Employees")</h2><form method="post" asp-page-handler="AddEmployee" class="row g-2 mb-3"><div class="col-md-5"><input asp-for="EmployeeName" class="form-control" placeholder="@T.Get(Context, "Full name")" /><span asp-validation-for="EmployeeName" class="text-danger small"></span></div><div class="col-md-5"><input asp-for="EmployeeEmail" class="form-control" placeholder="@T.Get(Context, "Google email")" /><span asp-validation-for="EmployeeEmail" class="text-danger small"></span></div><div class="col-md-2"><button class="btn btn-primary w-100">@T.Get(Context, "Add")</button></div></form><table class="table table-sm"><thead><tr><th>@T.Get(Context, "Name")</th><th>@T.Get(Context, "Email")</th><th>@T.Get(Context, "Status")</th><th></th></tr></thead><tbody>@foreach (var employee in Model.Employees) { <tr><td>@employee.Name</td><td>@employee.Email</td><td>@T.Get(Context, employee.IsActive ? "Active" : "Inactive")</td><td><form method="post" asp-page-handler="ToggleEmployee"><input type="hidden" name="id" value="@employee.Id" /><button class="btn btn-sm btn-outline-secondary">@T.Get(Context, "Toggle")</button></form></td></tr> }</tbody></table></div></div></div>
    <div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">@T.Get(Context, "Administrators")</h2><form method="post" asp-page-handler="AddAdministrator" class="row g-2 mb-3"><div class="col-md-4"><input asp-for="AdministratorName" class="form-control" placeholder="@T.Get(Context, "Administrator name")" /></div><div class="col-md-5"><input asp-for="AdministratorEmail" class="form-control" placeholder="@T.Get(Context, "Administrator Google email")" /><span asp-validation-for="AdministratorEmail" class="text-danger small"></span></div><div class="col-md-3"><button class="btn btn-primary w-100">@T.Get(Context, "Invite")</button></div></form><table class="table table-sm"><thead><tr><th>@T.Get(Context, "Name")</th><th>@T.Get(Context, "Email")</th><th>@T.Get(Context, "Status")</th><th></th></tr></thead><tbody>@foreach (var administrator in Model.Administrators) { <tr><td>@administrator.DisplayName</td><td>@administrator.Email</td><td>@T.Get(Context, administrator.IsActive ? "Active" : "Inactive")</td><td><form method="post" asp-page-handler="ToggleAdministrator" class="d-inline"><input type="hidden" name="id" value="@administrator.Id" /><button class="btn btn-sm btn-outline-secondary">@T.Get(Context, "Toggle")</button></form> <form method="post" asp-page-handler="RemoveAdministrator" class="d-inline" onsubmit="return confirm('@T.Get(Context, "Remove administrator rights?")');"><input type="hidden" name="id" value="@administrator.Id" /><button class="btn btn-sm btn-outline-danger">@T.Get(Context, "Remove admin rights")</button></form></td></tr> }</tbody></table></div></div></div>
    <div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">@T.Get(Context, "Leave types")</h2><form method="post" asp-page-handler="AddLeaveType" class="input-group mb-3"><input asp-for="LeaveTypeName" class="form-control" placeholder="@T.Get(Context, "New leave type")" /><button class="btn btn-primary">@T.Get(Context, "Add")</button></form><table class="table table-sm"><thead><tr><th>@T.Get(Context, "Type")</th><th>@T.Get(Context, "Status")</th><th></th></tr></thead><tbody>@foreach (var type in Model.LeaveTypes) { <tr><td>@type.Name</td><td>@T.Get(Context, type.IsActive ? "Active" : "Inactive")</td><td><form method="post" asp-page-handler="ToggleLeaveType"><input type="hidden" name="id" value="@type.Id" /><button class="btn btn-sm btn-outline-secondary">@T.Get(Context, "Toggle")</button></form></td></tr> }</tbody></table></div></div></div>
    <div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">@T.Get(Context, "Report recipients")</h2><form method="post" asp-page-handler="AddRecipient" class="input-group mb-3"><input asp-for="RecipientEmail" class="form-control" placeholder="accounting@example.com" /><button class="btn btn-primary">@T.Get(Context, "Add")</button></form><table class="table table-sm"><thead><tr><th>@T.Get(Context, "Email")</th><th>@T.Get(Context, "Status")</th><th></th></tr></thead><tbody>@foreach (var recipient in Model.Recipients) { <tr><td>@recipient.Email</td><td>@T.Get(Context, recipient.IsActive ? "Active" : "Inactive")</td><td><form method="post" asp-page-handler="ToggleRecipient"><input type="hidden" name="id" value="@recipient.Id" /><button class="btn btn-sm btn-outline-secondary">@T.Get(Context, "Toggle")</button></form></td></tr> }</tbody></table></div></div></div>
</div>
