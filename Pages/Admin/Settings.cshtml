@page
@model EfcomReport.Pages.Admin.SettingsModel
@{ ViewData["Title"] = "Employees and settings"; }
<h1>Employees and settings</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-4">
<div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Employees</h2><form method="post" asp-page-handler="AddEmployee" class="row g-2 mb-3"><div class="col-md-5"><input asp-for="EmployeeName" class="form-control" placeholder="Full name" /><span asp-validation-for="EmployeeName" class="text-danger small"></span></div><div class="col-md-5"><input asp-for="EmployeeEmail" class="form-control" placeholder="Google email" /><span asp-validation-for="EmployeeEmail" class="text-danger small"></span></div><div class="col-md-2"><button class="btn btn-primary w-100">Add</button></div></form><table class="table table-sm"><thead><tr><th>Name</th><th>Email</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var employee in Model.Employees) { <tr><td>@employee.Name</td><td>@employee.Email</td><td>@(employee.IsActive ? "Active" : "Inactive")</td><td><form method="post" asp-page-handler="ToggleEmployee"><input type="hidden" name="id" value="@employee.Id" /><button class="btn btn-sm btn-outline-secondary">Toggle</button></form></td></tr> }</tbody></table></div></div></div>
<div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Leave types</h2><form method="post" asp-page-handler="AddLeaveType" class="input-group mb-3"><input asp-for="LeaveTypeName" class="form-control" placeholder="New leave type" /><button class="btn btn-primary">Add</button></form><table class="table table-sm"><thead><tr><th>Type</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var type in Model.LeaveTypes) { <tr><td>@type.Name</td><td>@(type.IsActive ? "Active" : "Inactive")</td><td><form method="post" asp-page-handler="ToggleLeaveType"><input type="hidden" name="id" value="@type.Id" /><button class="btn btn-sm btn-outline-secondary">Toggle</button></form></td></tr> }</tbody></table></div></div></div>
<div class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Report recipients</h2><form method="post" asp-page-handler="AddRecipient" class="input-group mb-3"><input asp-for="RecipientEmail" class="form-control" placeholder="accounting@example.com" /><button class="btn btn-primary">Add</button></form><table class="table table-sm"><thead><tr><th>Email</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var recipient in Model.Recipients) { <tr><td>@recipient.Email</td><td>@(recipient.IsActive ? "Active" : "Inactive")</td><td><form method="post" asp-page-handler="ToggleRecipient"><input type="hidden" name="id" value="@recipient.Id" /><button class="btn btn-sm btn-outline-secondary">Toggle</button></form></td></tr> }</tbody></table></div></div></div>
</div>
