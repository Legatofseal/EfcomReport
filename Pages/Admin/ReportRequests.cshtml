@page
@model EfcomReport.Pages.Admin.ReportRequestsModel
@{ ViewData["Title"] = T.Get(Context, "Request a report"); }

<h1>@T.Get(Context, "Request reports from employees")</h1>
<p class="text-muted">@T.Get(Context, "Select a month to see who has not submitted. Missing submissions are selected by default.")</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="get" class="form-card mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">@T.Get(Context, "Month")</label>
            <select class="form-select" name="month" onchange="this.form.submit()">
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(Model.CurrentMonth == month ? "selected" : null)">@T.MonthName(Context, month)</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">@T.Get(Context, "Year")</label>
            <input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" onchange="this.form.submit()" />
        </div>
        <div class="col-md-4">
            <noscript><button class="btn btn-outline-primary" type="submit">@T.Get(Context, "Open")</button></noscript>
        </div>
    </div>
</form>

<form method="post" asp-page-handler="Send" class="form-card mb-4">
    <input type="hidden" name="year" value="@Model.CurrentYear" />
    <input type="hidden" name="month" value="@Model.CurrentMonth" />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">@T.Get(Context, "Employees")</h2>
        <span class="text-muted">@T.MonthName(Context, Model.CurrentMonth) @Model.CurrentYear</span>
    </div>
    <p class="text-muted small">@T.Get(Context, "Missing submissions are highlighted and selected by default.")</p>
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead><tr><th></th><th>@T.Get(Context, "Name")</th><th>@T.Get(Context, "Email")</th><th>@T.Get(Context, "Submission status")</th></tr></thead>
            <tbody>
                @foreach (var item in Model.EmployeeStatuses)
                {
                    var missing = item.State == "Did not submit this month";
                    <tr class="@(missing ? "table-danger" : "")">
                        <td><input class="form-check-input" type="checkbox" name="SelectedEmployeeIds" value="@item.Employee.Id" checked="@(Model.SelectedEmployeeIds.Contains(item.Employee.Id) ? "checked" : null)" /></td>
                        <td>@item.Employee.Name</td>
                        <td>@item.Employee.Email</td>
                        <td class="@(missing ? "text-danger fw-semibold" : "")">@T.Get(Context, item.State)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <button class="btn btn-primary" type="submit">@T.Get(Context, "Request reports from selected employees")</button>
</form>

<h2 class="h5">@T.Get(Context, "Recent requests")</h2>
<div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>@T.Get(Context, "Employee")</th><th>@T.Get(Context, "Period")</th><th>@T.Get(Context, "Sent to")</th><th>@T.Get(Context, "Requested at")</th><th>@T.Get(Context, "By")</th></tr></thead><tbody>@foreach (var request in Model.RecentRequests) { <tr><td>@request.Employee.Name</td><td>@T.MonthName(Context, request.Month) @request.Year</td><td>@request.SentToEmail</td><td>@request.RequestedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@request.RequestedByEmail</td></tr> }</tbody></table></div>
