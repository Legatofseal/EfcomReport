@page
@model EfcomReport.Pages.Admin.ReportRequestsModel
@{ ViewData["Title"] = T.Get(Context, "Request a report"); }
<h1>@T.Get(Context, "Request a report from an employee")</h1>
<p class="text-muted">@T.Get(Context, "The selected employee receives an email asking them to submit the selected month, or confirm that there was no absence.")</p>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post" asp-page-handler="Send" class="form-card mb-4">
    <div class="row g-3"><div class="col-md-5"><label class="form-label" asp-for="EmployeeId">@T.Get(Context, "Employee")</label><select class="form-select" asp-for="EmployeeId"><option value="">@T.Get(Context, "Select...")</option>@foreach (var employee in Model.Employees) { <option value="@employee.Id">@employee.Name — @employee.Email</option> }</select></div><div class="col-md-3"><label class="form-label">@T.Get(Context, "Month")</label><select class="form-select" name="month">@for (var month = 1; month <= 12; month++) { <option value="@month" selected="@(Model.CurrentMonth == month ? "selected" : null)">@T.MonthName(Context, month)</option> }</select></div><div class="col-md-3"><label class="form-label">@T.Get(Context, "Year")</label><input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" /></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary" type="submit">@T.Get(Context, "Send")</button></div></div>
</form>
<h2 class="h5">@T.Get(Context, "Recent requests")</h2>
<div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>@T.Get(Context, "Employee")</th><th>@T.Get(Context, "Period")</th><th>@T.Get(Context, "Sent to")</th><th>@T.Get(Context, "Requested at")</th><th>@T.Get(Context, "By")</th></tr></thead><tbody>@foreach (var request in Model.RecentRequests) { <tr><td>@request.Employee.Name</td><td>@T.MonthName(Context, request.Month) @request.Year</td><td>@request.SentToEmail</td><td>@request.RequestedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@request.RequestedByEmail</td></tr> }</tbody></table></div>
