@page
@model EfcomReport.Pages.Admin.ReportRequestsModel
@{ ViewData["Title"] = "Request a report"; }
<h1>Request a report from an employee</h1>
<p class="text-muted">The selected employee receives an email asking them to submit the selected month, or confirm that there was no absence.</p>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post" asp-page-handler="Send" class="form-card mb-4">
    <div class="row g-3"><div class="col-md-5"><label class="form-label" asp-for="EmployeeId">Employee</label><select class="form-select" asp-for="EmployeeId"><option value="">Select...</option>@foreach (var employee in Model.Employees) { <option value="@employee.Id">@employee.Name — @employee.Email</option> }</select></div><div class="col-md-3"><label class="form-label">Month</label><input class="form-control" type="number" name="month" min="1" max="12" value="@Model.CurrentMonth" /></div><div class="col-md-3"><label class="form-label">Year</label><input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" /></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary" type="submit">Send</button></div></div>
</form>
<h2 class="h5">Recent requests</h2>
<div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>Employee</th><th>Period</th><th>Sent to</th><th>Requested at</th><th>By</th></tr></thead><tbody>@foreach (var request in Model.RecentRequests) { <tr><td>@request.Employee.Name</td><td>@request.Year-@request.Month.ToString("00")</td><td>@request.SentToEmail</td><td>@request.RequestedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@request.RequestedByEmail</td></tr> }</tbody></table></div>
