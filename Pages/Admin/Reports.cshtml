@page
@model EfcomReport.Pages.Admin.ReportsModel
@{ ViewData["Title"] = T.Get(Context, "Reports"); }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>@T.Get(Context, "Reports")</h1><form method="get" class="d-flex gap-2" aria-label="Report period"><select class="form-select" name="month" onchange="this.form.submit()" aria-label="@T.Get(Context, "Month")">@for (var month = 1; month <= 12; month++) { <option value="@month" selected="@(Model.CurrentMonth == month ? "selected" : null)">@T.MonthName(Context, month)</option> }</select><input class="form-control" type="number" name="year" min="2020" max="2100" value="@Model.CurrentYear" onchange="this.form.submit()" aria-label="@T.Get(Context, "Year")" /><noscript><button class="btn btn-outline-primary">@T.Get(Context, "Open")</button></noscript></form></div>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (Model.Report is not null)
{
<p><a class="btn btn-outline-secondary" asp-page-handler="Csv" asp-route-year="@Model.CurrentYear" asp-route-month="@Model.CurrentMonth">@T.Get(Context, "Download CSV")</a></p>
<form method="post" asp-page-handler="Send" class="card mb-3"><div class="card-body"><h2 class="h5">@T.Get(Context, "Send report")</h2><input type="hidden" name="year" value="@Model.CurrentYear" /><input type="hidden" name="month" value="@Model.CurrentMonth" /><div class="mb-2">@foreach (var recipient in Model.Recipients) { <label class="d-block"><input type="checkbox" name="SelectedRecipientIds" value="@recipient.Id" /> @recipient.Email</label> }</div><button class="btn btn-primary">@T.Get(Context, "Send selected recipients")</button></div></form>
<div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>@T.Get(Context, "Employee")</th>@foreach (var type in Model.Report.Types) { <th>@type.Name days</th><th>@type.Name entries</th> }<th>Total</th><th>@T.Get(Context, "Monthly submission")</th></tr></thead><tbody>@foreach (var row in Model.Report.Rows) { <tr class="@(row.SubmissionState == "Did not submit this month" ? "table-danger" : "")"><td>@row.EmployeeName</td>@foreach (var type in Model.Report.Types) { <td>@row.DaysByType.GetValueOrDefault(type.Name)</td><td>@row.EntryCounts.GetValueOrDefault(type.Name)</td> }<td>@row.TotalDays</td><td>@T.Get(Context, row.SubmissionState)</td></tr> }</tbody></table></div>
}
