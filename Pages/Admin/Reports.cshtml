@page
@model EfcomReport.Pages.Admin.ReportsModel
@using System.Globalization
@{ ViewData["Title"] = T.Get(Context, "Reports"); }

<h1>@T.Get(Context, "Reports")</h1>

<form method="get" class="card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">@T.Get(Context, "Start month")</label>
                <select class="form-select" name="startMonth" onchange="this.form.submit()">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month" selected="@(Model.CurrentStartMonth == month ? "selected" : null)">@T.MonthName(Context, month)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">@T.Get(Context, "Start year")</label>
                <input class="form-control" type="number" name="startYear" min="2020" max="2100" value="@Model.CurrentStartYear" onchange="this.form.submit()" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@T.Get(Context, "End month")</label>
                <select class="form-select" name="endMonth" onchange="this.form.submit()">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month" selected="@(Model.CurrentEndMonth == month ? "selected" : null)">@T.MonthName(Context, month)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">@T.Get(Context, "End year")</label>
                <input class="form-control" type="number" name="endYear" min="2020" max="2100" value="@Model.CurrentEndYear" onchange="this.form.submit()" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">@T.Get(Context, "Apply filters")</button>
            </div>
        </div>

        <div class="mt-4">
            <h2 class="h6">@T.Get(Context, "Employees")</h2>
            <p class="text-muted small">@T.Get(Context, "By default, all active employees are included.")</p>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-2">
                @foreach (var employee in Model.Employees)
                {
                    <div class="col">
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="employeeIds" value="@employee.Id" checked="@(Model.SelectedEmployeeIds.Contains(employee.Id) ? "checked" : null)" />
                            <span class="form-check-label">@employee.Name <span class="text-muted small">(@employee.Email)</span></span>
                        </label>
                    </div>
                }
            </div>
        </div>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.Report is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">@T.Get(Context, "Report period"): @T.MonthName(Context, Model.Report.StartMonth) @Model.Report.StartYear – @T.MonthName(Context, Model.Report.EndMonth) @Model.Report.EndYear</h2>
        <a class="btn btn-outline-secondary" href="@Model.CsvUrl">@T.Get(Context, "Download report package")</a>
    </div>

    @if (Model.Report.IsSingleMonth)
    {
        <div class="card border-warning mb-3">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <strong>@T.Get(Context, "Delete month records")</strong>
                    <div class="text-muted small">@T.Get(Context, "Available only after every active employee has confirmed this month. Multi-month absence records are retained.")</div>
                </div>
                @if (Model.CanDeleteCurrentMonth)
                {
                    <form method="post" asp-page-handler="DeleteMonth" onsubmit="return confirm('@T.Get(Context, "Delete all records for this month?")');">
                        <input type="hidden" name="year" value="@Model.Report.StartYear" />
                        <input type="hidden" name="month" value="@Model.Report.StartMonth" />
                        <button class="btn btn-outline-danger" type="submit">@T.Get(Context, "Delete month records")</button>
                    </form>
                }
                else
                {
                    <span class="badge text-bg-secondary">@T.Get(Context, "Waiting for confirmations")</span>
                }
            </div>
        </div>
    }

    <form method="post" asp-page-handler="Send" class="card mb-3">
        <div class="card-body">
            <h2 class="h5">@T.Get(Context, "Send report")</h2>
            <input type="hidden" name="startYear" value="@Model.Report.StartYear" />
            <input type="hidden" name="startMonth" value="@Model.Report.StartMonth" />
            <input type="hidden" name="endYear" value="@Model.Report.EndYear" />
            <input type="hidden" name="endMonth" value="@Model.Report.EndMonth" />
            @foreach (var employeeId in Model.SelectedEmployeeIds)
            {
                <input type="hidden" name="employeeIds" value="@employeeId" />
            }
            <div class="mb-2">
                @foreach (var recipient in Model.Recipients)
                {
                    <label class="d-block"><input type="checkbox" name="SelectedRecipientIds" value="@recipient.Id" /> @recipient.Email</label>
                }
            </div>
            <button class="btn btn-primary">@T.Get(Context, "Send selected recipients")</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm table-striped report-table">
            <thead>
                <tr>
                    <th scope="col"><button type="button" class="report-sort-button" data-sort-type="text">@T.Get(Context, "Employee")</button></th>
                    @foreach (var type in Model.Report.Types)
                    {
                        <th scope="col"><button type="button" class="report-sort-button" data-sort-type="number">@type.Name @T.Get(Context, "Days")</button></th>
                        <th scope="col"><button type="button" class="report-sort-button" data-sort-type="number">@type.Name @T.Get(Context, "Entries")</button></th>
                    }
                    <th scope="col"><button type="button" class="report-sort-button" data-sort-type="number">@T.Get(Context, "Total leave days")</button></th>
                    <th scope="col"><button type="button" class="report-sort-button" data-sort-type="text">@T.Get(Context, "Submission status")</button></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Report.Rows)
                {
                    var hasMissingSubmission = row.SubmissionStatuses.Any(x => x.State == "Not confirmed");
                    <tr class="@(hasMissingSubmission ? "table-danger" : "")">
                        <td data-sort-value="@row.EmployeeName">@row.EmployeeName</td>
                        @foreach (var type in Model.Report.Types)
                        {
                            var days = row.DaysByType.GetValueOrDefault(type.Name);
                            var entries = row.EntryCounts.GetValueOrDefault(type.Name);
                            <td data-sort-value="@days.ToString(CultureInfo.InvariantCulture)">@days.ToString("0.##")</td>
                            <td data-sort-value="@entries">@entries</td>
                        }
                        <td data-sort-value="@row.TotalDays.ToString(CultureInfo.InvariantCulture)">@row.TotalDays.ToString("0.##")</td>
                        <td data-sort-value="@(hasMissingSubmission ? "Not confirmed" : "Confirmed")">
                            @foreach (var status in row.SubmissionStatuses)
                            {
                                <div class="@(status.State == "Not confirmed" ? "text-danger fw-semibold" : "")">
                                    @(Model.Report.IsSingleMonth ? "" : $"{T.MonthName(Context, status.Month)} {status.Year}: ")@T.Get(Context, status.State)
                                    @if (status.ConfirmedAtUtc is not null)
                                    {
                                        <span class="text-muted small">(@status.ConfirmedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
                                    }
                                    @if (status.State == "Not confirmed")
                                    {
                                        <form method="post" asp-page-handler="Remind" class="d-inline ms-2">
                                            <input type="hidden" name="employeeId" value="@row.EmployeeId" />
                                            <input type="hidden" name="year" value="@status.Year" />
                                            <input type="hidden" name="month" value="@status.Month" />
                                            <input type="hidden" name="startYear" value="@Model.Report.StartYear" />
                                            <input type="hidden" name="startMonth" value="@Model.Report.StartMonth" />
                                            <input type="hidden" name="endYear" value="@Model.Report.EndYear" />
                                            <input type="hidden" name="endMonth" value="@Model.Report.EndMonth" />
                                            @foreach (var selectedEmployeeId in Model.SelectedEmployeeIds)
                                            {
                                                <input type="hidden" name="employeeIds" value="@selectedEmployeeId" />
                                            }
                                            <button class="btn btn-sm btn-outline-danger" type="submit">@T.Get(Context, "Remind")</button>
                                        </form>
                                    }
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const table = document.querySelector('.report-table');
            if (!table || !table.tBodies.length) return;

            const body = table.tBodies[0];
            const buttons = [...table.querySelectorAll('.report-sort-button')];
            let activeButton = null;
            let direction = 1;

            const compareValues = (left, right, type) => {
                if (type === 'number') {
                    const leftNumber = Number.parseFloat(left);
                    const rightNumber = Number.parseFloat(right);
                    return (Number.isNaN(leftNumber) ? 0 : leftNumber) - (Number.isNaN(rightNumber) ? 0 : rightNumber);
                }

                return left.localeCompare(right, undefined, { numeric: true, sensitivity: 'base' });
            };

            buttons.forEach(button => {
                button.addEventListener('click', () => {
                    direction = activeButton === button ? direction * -1 : 1;
                    activeButton = button;
                    const columnIndex = buttons.indexOf(button);
                    const type = button.dataset.sortType || 'text';
                    const rows = [...body.rows].map((row, originalIndex) => ({ row, originalIndex }));

                    rows.sort((left, right) => {
                        const leftCell = left.row.cells[columnIndex];
                        const rightCell = right.row.cells[columnIndex];
                        const leftValue = leftCell?.dataset.sortValue ?? leftCell?.textContent?.trim() ?? '';
                        const rightValue = rightCell?.dataset.sortValue ?? rightCell?.textContent?.trim() ?? '';
                        return (compareValues(leftValue, rightValue, type) * direction) || (left.originalIndex - right.originalIndex);
                    });

                    rows.forEach(({ row }) => body.appendChild(row));
                    buttons.forEach(item => {
                        item.classList.toggle('active', item === button);
                        if (item === button) {
                            const sortDirection = direction === 1 ? 'ascending' : 'descending';
                            item.dataset.sortDirection = sortDirection;
                            item.setAttribute('aria-label', `${item.textContent.trim()}, sort ${sortDirection}`);
                        } else {
                            delete item.dataset.sortDirection;
                            item.removeAttribute('aria-label');
                        }
                    });
                });
            });
        })();
    </script>
}
