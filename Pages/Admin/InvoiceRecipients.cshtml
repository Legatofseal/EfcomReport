@page
@model EfcomReport.Pages.Admin.InvoiceRecipientsModel
@{ ViewData["Title"] = T.Get(Context, "Invoice recipients"); }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">@T.Get(Context, "Invoice recipients")</h1>
        <p class="text-muted mb-0">@T.Get(Context, "Choose who receives invoice emails from the Invoices module.")</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Admin/Index">@T.Get(Context, "Administration")</a>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">@T.Get(Context, "Add invoice recipient")</h2>
        <form method="post" asp-page-handler="Add" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label asp-for="RecipientName" class="form-label">@T.Get(Context, "Recipient name")</label>
                <input asp-for="RecipientName" class="form-control" placeholder="Accounting" />
                <span asp-validation-for="RecipientName" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="RecipientEmail" class="form-label">@T.Get(Context, "Invoice recipient email")</label>
                <input asp-for="RecipientEmail" class="form-control" type="email" placeholder="accounting@example.com" />
                <span asp-validation-for="RecipientEmail" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary w-100" type="submit">@T.Get(Context, "Add")</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h5">@T.Get(Context, "Configured recipients")</h2>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>@T.Get(Context, "Name")</th><th>@T.Get(Context, "Email")</th><th>@T.Get(Context, "Status")</th><th>@T.Get(Context, "Default")</th><th></th></tr></thead>
                <tbody>
                @if (Model.Recipients.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">@T.Get(Context, "No invoice recipients configured yet.")</td></tr>
                }
                @foreach (var recipient in Model.Recipients)
                {
                    <tr>
                        <td>@recipient.Name</td>
                        <td>@recipient.Email</td>
                        <td>@T.Get(Context, recipient.IsActive ? "Active" : "Inactive")</td>
                        <td>@(recipient.IsDefault ? T.Get(Context, "Yes") : "")</td>
                        <td class="text-end text-nowrap">
                            @if (recipient.IsActive && !recipient.IsDefault)
                            {
                                <form method="post" asp-page-handler="SetDefault" class="d-inline">
                                    <input type="hidden" name="id" value="@recipient.Id" />
                                    <button class="btn btn-sm btn-outline-primary" type="submit">@T.Get(Context, "Set default")</button>
                                </form>
                            }
                            <form method="post" asp-page-handler="Toggle" class="d-inline">
                                <input type="hidden" name="id" value="@recipient.Id" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">@T.Get(Context, "Toggle")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
